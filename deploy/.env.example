# Copy to .env and fill in. Keep .env readable only by root (chmod 600).
# .env is git-ignored and must never be committed.

# PostgreSQL password for the 'miningcore' role (used by both the db container
# and Miningcore). Generate a strong one, e.g.: openssl rand -base64 32
POSTGRES_PASSWORD=

# Cascoin payout/pool address. MUST be a valid address owned by the daemon
# wallet on the wallet host - pool rewards are paid from/tracked against it.
POOL_ADDRESS=

# Cascoin daemon RPC credentials - copy from cascoin.conf on the wallet host
# (rpcuser / rpcpassword).
RPC_USER=
RPC_PASSWORD=

# ---- DigiByte (multi-algo: SHA256d / Scrypt / Skein / Qubit) ---------------
# DigiByte payout address owned by the daemon's 'pool' wallet on the wallet
# host (10.0.0.2:8432). Used by all four DGB algo pools.
DGB_POOL_ADDRESS=

# DigiByte daemon RPC credentials - copy from digibyte.conf on the wallet host.
DGB_RPC_USER=
DGB_RPC_PASSWORD=

# ---- Bitcoin Silver (SHA256d, single algo) --------------------------------
# Bitcoin Silver payout address owned by the daemon's 'pool' wallet on the
# wallet host (10.0.0.2:1000).
BTCS_POOL_ADDRESS=

# Bitcoin Silver daemon RPC credentials - from bitcoinsilver.conf.
BTCS_RPC_USER=
BTCS_RPC_PASSWORD=

# ---- Dashboard / Traefik (all optional, sensible defaults shown) ----------
# Public domain the dashboard + API are served on. DNS A record must point at
# this host BEFORE the first deploy so Let's Encrypt can issue a certificate.
DASHBOARD_DOMAIN=new.mining-pool.io

# Contact e-mail for the Let's Encrypt account (expiry notices).
ACME_EMAIL=support@mining-pool.io

# Hostname miners use in their stratum URL, shown in the dashboard connection
# lines. Usually the same as DASHBOARD_DOMAIN.
STRATUM_HOST=new.mining-pool.io
